{
  "name": "merchiva",
  "version": "0.1.0-beta",
  "description": "Merchiva — daily management platform for small businesses.",
  "author": {
    "name": "Merchiva",
    "email": "colinwilsonfan@gmail.com"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:static": "bun scripts/build-static.ts",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build": "bun run build && npx cap sync",
    "migrate": "tsx scripts/migrate-supabase-to-stdb.ts",
    "electron:dev": "concurrently -k \"bun run dev\" \"wait-on http://localhost:3000 && NODE_ENV=development electron electron/main.js\"",
    "electron:build": "electron-builder",
    "electron:dist": "electron-builder --mac --win --linux",
    "electron:dist:mac": "electron-builder --mac",
    "electron:dist:win": "electron-builder --win",
    "electron:dist:linux": "electron-builder --linux"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.merchiva.desktop",
    "productName": "Merchiva",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "asarUnpack": [],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "electron/**/*",
      "package.json",
      "!**/node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/argparse/**/*",
      "node_modules/sprintf-js/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/universalify/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*"
    ],
    "protocols": [
      {
        "name": "Merchiva",
        "schemes": [
          "merchiva"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RiceBarrels",
        "repo": "Merchiva",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "Merchiva <colinwilsonfan@gmail.com>"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@base-ui/react": "^1.3.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@craftjs/core": "^0.2.12",
    "@craftjs/layers": "^0.2.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eigenpal/docx-js-editor": "^0.5.1",
    "@monaco-editor/react": "^4.7.0",
    "@stripe/stripe-js": "^9.5.0",
    "@uploadthing/react": "^7.3.3",
    "@workos-inc/node": "^9.1.0",
    "ai": "^6.0.182",
    "bun": "^1.3.13",
    "capacitor-plugin-safe-area": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.2.2",
    "openai": "^6.37.0",
    "quill": "^2.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "spacetimedb": "^2.2.0",
    "square": "^44.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
