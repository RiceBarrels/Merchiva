{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merchiva",
  "version": "0.1.0",
  "identifier": "com.merchiva.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Daily management platform for small businesses",
    "longDescription": "Merchiva — inventory, sales, staffing, POS, and AI insights in one workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["merchiva"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/RiceBarrels/Merchiva/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
